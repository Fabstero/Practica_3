@model Practica_2.Application.Dtos.ResumenVotacionDto
@{
    ViewData["Title"] = "Inicio";
}

<section class="home-page">
    <div class="home-heading">
        <h1>Sistema de Votaciones<br /><span>en tiempo real.</span></h1>
        <p>Administra el padrón electoral, los partidos políticos y el escrutinio desde un solo lugar.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="metric-card">
                <div class="metric-icon metric-icon-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <span class="metric-label">Padrón Electoral</span>
                    <h3 class="metric-value">@Model.TotalVotantes</h3>
                    <small class="text-muted">@Model.VotantesPendientes pendientes de votar</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="metric-card">
                <div class="metric-icon metric-icon-success">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <span class="metric-label">Votos Emitidos</span>
                    <h3 class="metric-value">@Model.TotalVotosEmitidos</h3>
                    <small class="text-muted">Voto único verificado</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="metric-card">
                <div class="metric-icon metric-icon-info">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <span class="metric-label">Participación</span>
                    <h3 class="metric-value">@Model.PorcentajeParticipacion.ToString("0.0")%</h3>
                    <small class="text-muted">Sobre padrón activo</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="metric-card">
                <div class="metric-icon metric-icon-warning">
                    <i class="bi bi-flag-fill"></i>
                </div>
                <div>
                    <span class="metric-label">Partidos Activos</span>
                    <h3 class="metric-value">@Model.PartidosActivos <span class="fs-6 text-muted">/ @Model.TotalPartidos</span></h3>
                    <small class="text-muted">Habilitados en urna</small>
                </div>
            </div>
        </div>
    </div>

    <a class="home-feature" asp-controller="Voto" asp-action="Index">
        <div class="home-feature-icon"><i class="bi bi-box2-heart-fill"></i></div>
        <div class="home-feature-copy">
            <span class="home-feature-label">VOTACIÓN</span>
            <h2>Urna Electrónica y Escrutinio</h2>
            <p>Emite votos de forma atómica con validación de cédula única, consulta el escrutinio en vivo y revisa el historial.</p>
        </div>
        <span class="home-feature-link">Ir a la urna <i class="bi bi-arrow-up-right"></i></span>
    </a>

    <a class="home-feature" asp-controller="Votante" asp-action="Index">
        <div class="home-feature-icon"><i class="bi bi-people-fill"></i></div>
        <div class="home-feature-copy">
            <span class="home-feature-label">PADRÓN</span>
            <h2>Gestión de Votantes</h2>
            <p>Consulta, registra, edita y controla el estado de votación de cada persona empadronada por cédula y provincia.</p>
        </div>
        <span class="home-feature-link">Ver votantes <i class="bi bi-arrow-up-right"></i></span>
    </a>

    <a class="home-feature" asp-controller="Partido" asp-action="Index">
        <div class="home-feature-icon"><i class="bi bi-flag-fill"></i></div>
        <div class="home-feature-copy">
            <span class="home-feature-label">CANDIDATURAS</span>
            <h2>Partidos Políticos</h2>
            <p>Administra partidos, siglas, candidaturas, banderas y su disponibilidad en la papeleta electoral.</p>
        </div>
        <span class="home-feature-link">Ver partidos <i class="bi bi-arrow-up-right"></i></span>
    </a>

    <div class="home-note">
        <span class="home-note-mark"><i class="bi bi-shield-check"></i></span>
        <p><strong>Integridad garantizada.</strong> La base de datos SQLite aplica llaves foráneas <code>ON DELETE RESTRICT</code>, unicidad de voto por votante y validaciones automáticas en cada operación.</p>
    </div>
</section>
